# Secrets — never commit real keys
.env

# Python / tooling
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
spark-warehouse/
metastore_db/
derby.log

# Raw pulls contain usernames / channel IDs (privacy rule) and can be large.
# Keep the folder, ignore its contents. Re-download with `make collect`.
data/raw/*
!data/raw/.gitkeep

# IMDb 50K corpus is ~65 MB — too big for the repo; each member copies it locally (M4)
data/manual/imdb_50k.csv

# OS junk
.DS_Store

# Final zip is built locally, not committed
*_FinalSubmission.zip

# Full comment tables are ~45 MB each — rebuilt by `make collect clean`; a sample is committed instead
data/interim/yt_comments.csv
data/clean/comments.csv

# Intermediate report build files — regenerated by `make report` from the templates
report/report.md
report/report.html
report/slides.md
