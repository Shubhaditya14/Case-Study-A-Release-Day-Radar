// ER diagram for sql/schema.sql — render with:  dot -Tpng report/er_diagram.dot -o report/er_diagram.png
digraph ER {
    graph [rankdir=LR, fontname="Helvetica", bgcolor="white", pad=0.3, nodesep=0.5, ranksep=1.2];
    node  [shape=plain, fontname="Helvetica", fontsize=11];
    edge  [fontname="Helvetica", fontsize=10, color="#555555", arrowhead=crow, arrowtail=tee, dir=both];

    films [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
        <tr><td bgcolor="#1f4e79"><font color="white"><b>films</b></font></td></tr>
        <tr><td align="left" port="pk"><b>film_id</b> (PK)</td></tr>
        <tr><td align="left">title_clean</td></tr>
        <tr><td align="left">language</td></tr>
        <tr><td align="left">genre</td></tr>
        <tr><td align="left">runtime_min</td></tr>
        <tr><td align="left">release_date</td></tr>
        <tr><td align="left">budget_cr</td></tr>
        <tr><td align="left">tmdb_id (UNIQUE)</td></tr>
      </table>>];

    trailers [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
        <tr><td bgcolor="#2e75b6"><font color="white"><b>trailers</b></font></td></tr>
        <tr><td align="left"><b>trailer_id</b> (PK)</td></tr>
        <tr><td align="left" port="fk">film_id (FK)</td></tr>
        <tr><td align="left">youtube_video_id (UNIQUE)</td></tr>
        <tr><td align="left">is_main_trailer</td></tr>
        <tr><td align="left">publish_ts</td></tr>
        <tr><td align="left">views, likes, comment_count</td></tr>
      </table>>];

    box_office [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
        <tr><td bgcolor="#2e75b6"><font color="white"><b>box_office</b></font></td></tr>
        <tr><td align="left" port="fk"><b>film_id</b> (PK, FK)</td></tr>
        <tr><td align="left"><b>metric</b> (PK)</td></tr>
        <tr><td align="left"><b>source</b> (PK)</td></tr>
        <tr><td align="left">value_cr</td></tr>
        <tr><td align="left">note</td></tr>
      </table>>];

    comments [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
        <tr><td bgcolor="#2e75b6"><font color="white"><b>comments</b></font></td></tr>
        <tr><td align="left"><b>comment_id</b> (PK)</td></tr>
        <tr><td align="left" port="fk">film_id (FK)</td></tr>
        <tr><td align="left">published_ts</td></tr>
        <tr><td align="left">text_clean</td></tr>
        <tr><td align="left">length</td></tr>
        <tr><td align="left">vader_compound</td></tr>
      </table>>];

    trends_daily [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
        <tr><td bgcolor="#2e75b6"><font color="white"><b>trends_daily</b></font></td></tr>
        <tr><td align="left" port="fk"><b>film_id</b> (PK, FK)</td></tr>
        <tr><td align="left"><b>date</b> (PK)</td></tr>
        <tr><td align="left">interest</td></tr>
      </table>>];

    // One film has many rows in each child table (1 : N)
    films:pk -> trailers:fk     [label="1 : N"];
    films:pk -> box_office:fk   [label="1 : N"];
    films:pk -> comments:fk     [label="1 : N"];
    films:pk -> trends_daily:fk [label="1 : N"];
}
