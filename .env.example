# Copy this file to .env and fill in real values. .env is gitignored.

# M1 — YouTube Data API v3 key (Google Cloud Console → Credentials → API key)
YT_API_KEY=

# M2 — TMDb API key (v3 "API Key", not the long read-access token)
TMDB_API_KEY=

# M3 — MySQL 8 connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=radar
MYSQL_PASSWORD=
MYSQL_DB=release_day_radar

# Contact string sent in the User-Agent header to Wikipedia (their API etiquette asks for one)
WIKI_CONTACT=your-email@example.com
